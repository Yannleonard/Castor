# =============================================================================
# Castor — environment template.
#
#   cp deploy/env.example .env
#   # then edit .env (at minimum, set a real CASTOR_SECRET_KEY)
#   docker compose -f deploy/docker-compose.yml --env-file .env up -d
#
# docker compose auto-loads a `.env` file sitting next to where you run it. The
# committed compose files pass through the variables they reference; any other
# variable below takes effect only once added under `environment:` in the
# compose file. NEVER commit your real .env.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — secret key for AES-256-GCM (TOTP secrets and the private key of an
# imported certificate, sealed at rest) and derived crypto. Must be a 32-byte
# key, encoded as 64 hexadecimal characters. The backend refuses to start if
# this is unset or not exactly 32 bytes.
#
#   Generate:   openssl rand -hex 32
#   (NOTE: `openssl rand -hex 16` -> 32 chars = only 16 bytes = WRONG. Use -hex 32.)
# -----------------------------------------------------------------------------
CASTOR_SECRET_KEY=REPLACE_ME_WITH_OUTPUT_OF_openssl_rand_-hex_32

# -----------------------------------------------------------------------------
# Docker socket group id — lets Castor (non-root, uid 65532) talk to the socket
# without running as root. Find it on the host:
#
#   getent group docker | cut -d: -f3      # commonly 999
#
# Defaults to 999 if unset.
# -----------------------------------------------------------------------------
DOCKER_GID=999

# -----------------------------------------------------------------------------
# OPTIONAL — listen addresses inside the container (host ports are mapped in
# compose). HTTPS serves the UI and the API. HTTP answers the healthcheck and
# the Let's Encrypt challenges and redirects everything else to HTTPS; it is
# the only listener when CASTOR_TLS_MODE=off. The HTTPS port must be the one
# published on the host: the redirect points at https://<host>:<this port>
# (no port when Castor is reached without one, e.g. via 80/443).
# -----------------------------------------------------------------------------
# CASTOR_HTTPS_ADDR=:8443
# CASTOR_HTTP_ADDR=:8080

# -----------------------------------------------------------------------------
# OPTIONAL — default TLS mode. The mode chosen in Settings → HTTPS &
# certificates takes precedence, except `off`: set in the environment, it is
# managed by the environment and cannot be changed from the UI.
#   self-signed  certificate generated by Castor (default)
#   custom       certificate imported in Settings
#   acme         Let's Encrypt — public DNS name, host ports 80/443 published
#                to 8080/8443, enabled in Settings; public URL https://<domain>
#   off          plain HTTP on CASTOR_HTTP_ADDR only, for a reverse proxy that
#                terminates TLS (set CASTOR_TRUST_PROXY=true as well)
# -----------------------------------------------------------------------------
# CASTOR_TLS_MODE=self-signed

# -----------------------------------------------------------------------------
# OPTIONAL — extra names / IPs (comma-separated) covered by the self-signed
# certificate, on top of localhost and the container hostname. The certificate
# is regenerated at the next start when it does not cover them.
# -----------------------------------------------------------------------------
# CASTOR_TLS_SELF_SIGNED_HOSTS=castor.lan,192.168.1.10

# -----------------------------------------------------------------------------
# OPTIONAL — where the self-signed key pair and the Let's Encrypt cache live
# (on the data volume), and whether plain HTTP redirects to HTTPS (false serves
# the application on both listeners).
# -----------------------------------------------------------------------------
# CASTOR_TLS_DIR=/data/tls
# CASTOR_HTTP_REDIRECT=true

# -----------------------------------------------------------------------------
# OPTIONAL — trust reverse-proxy forwarding headers (X-Forwarded-Proto / -For).
# Set to true ONLY when Castor sits behind a trusted TLS-terminating proxy
# (with CASTOR_TLS_MODE=off); this governs the Secure cookie flag, the client
# IP recorded in the audit log and the HTTP-to-HTTPS redirect.
# -----------------------------------------------------------------------------
# CASTOR_TRUST_PROXY=false

# -----------------------------------------------------------------------------
# OPTIONAL — self-protection seed (Castor's own container id/name). The backend
# also resolves its real container id at runtime from /proc/self/cgroup; this is
# a fallback hint. Compose passes the service container_name ("castor").
# -----------------------------------------------------------------------------
# CASTOR_SELF_CONTAINER_ID=castor

# -----------------------------------------------------------------------------
# OPTIONAL — one-time token gating POST /api/v1/bootstrap for unattended installs.
# Leave unset to use the interactive first-run "create admin" screen.
# -----------------------------------------------------------------------------
# CASTOR_BOOTSTRAP_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL — alternate Docker endpoint (e.g. a scoped docker-socket-proxy) instead
# of the bind-mounted raw socket. Hardened deployments should prefer a proxy.
#   e.g. tcp://docker-socket-proxy:2375
# -----------------------------------------------------------------------------
# CASTOR_DOCKER_HOST=

# -----------------------------------------------------------------------------
# OPTIONAL (Kubernetes overlay) — path to the mounted kubeconfig INSIDE the
# container. Set automatically by deploy/docker-compose.kube.yml.
# -----------------------------------------------------------------------------
# CASTOR_KUBECONFIG=/home/nonroot/.kube/config

# -----------------------------------------------------------------------------
# OPTIONAL — SQLite database path inside the container (on the /data volume).
# -----------------------------------------------------------------------------
# CASTOR_DB_PATH=/data/castor.db
